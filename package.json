{
  "name": "gigi",
  "productName": "GiGi",
  "version": "1.0.1",
  "description": "GiGi — a local all-in-one messenger. Combine many web services and accounts in one window, with notifications and unread counters. 100% local config, no cloud account, no telemetry.",
  "main": "src/main/main.js",
  "author": "GiGi",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.gigi.app",
    "productName": "GiGi",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "shadow-artlap",
        "repo": "GiGi"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GiGi"
    }
  }
}
