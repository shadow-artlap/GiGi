{
  "name": "localhub",
  "productName": "LocalHub",
  "version": "1.0.0",
  "description": "Local all-in-one messenger — combine many web services and accounts in one window, with notifications and unread counters. 100% local config, no cloud account, no telemetry.",
  "main": "src/main/main.js",
  "author": "LocalHub",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icon": "node gen-icon.js",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.localhub.app",
    "productName": "LocalHub",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "YOUR_GITHUB_USERNAME",
        "repo": "localhub"
      }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LocalHub"
    }
  }
}
